# ---- LLM keys (up to 6 rotated; single key also works) ----
GEMINI_API_KEY_1=your_key_1
GEMINI_API_KEY_2=your_key_2
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# GEMINI_API_KEY_5=
# GEMINI_API_KEY_6=

# ---- App access control (optional; leave APP_PASSWORD empty to run open) ----
# Shared password for the sign-in gate. Comma-separate for multiple passwords.
APP_PASSWORD=change-me
# Optional email allowlist (comma-separated). If set, a user must provide BOTH
# a listed email AND the password. Leave empty for password-only access.
APP_ALLOWED_EMAILS=alice@example.com,bob@example.com

# ---- Private knowledge bundle (public-repo deploys only) ----
# Full URL of the knowledge zip uploaded to a GitHub release on a PRIVATE repo,
# plus a token (classic PAT with 'repo' scope, or fine-grained read-only for
# that repo) that can download it. Leave both empty for local/dev use.
# KB_BUNDLE_URL=https://github.com/YOUR_USER/YOUR_PRIVATE_REPO/releases/download/v1/knowledge_bundle.zip
# KB_BUNDLE_TOKEN=github_pat_xxxx